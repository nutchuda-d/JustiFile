<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="justifile.Dashboard">
        <div class="o_action justifile_dashboard h-100 overflow-auto bg-view">
            <div class="container-fluid p-4" t-if="state.data">
                <t t-set="k" t-value="state.data.kpis"/>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="mb-0">Management Dashboard</h2>
                    <div class="d-flex align-items-center gap-2">
                        <label class="mb-0 text-nowrap" for="justifile_year">Budget year</label>
                        <select id="justifile_year" class="form-select" t-on-change="onYearChange">
                            <option value="" t-att-selected="!state.year">All years</option>
                            <option t-foreach="state.data.years" t-as="y" t-key="y" t-att-value="y"
                                    t-att-selected="y.toString() === state.year" t-esc="y"/>
                        </select>
                        <button class="btn btn-secondary" t-on-click="load">Refresh</button>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="justifile_kpi card h-100" t-on-click="() => this.openGroups([['state', '=', 'documented']], 'Documented')">
                            <div class="card-body">
                                <div class="justifile_kpi_value" t-esc="show(k.completeness_rate, '%')"/>
                                <div class="fw-bold">Documentation completeness</div>
                                <div class="text-muted small"><t t-esc="k.documented"/> of <t t-esc="k.total_groups"/> groups documented</div>
                                <div class="justifile_cmp small" t-esc="compare('completeness_rate', '%')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="justifile_kpi card h-100" t-on-click="() => this.openGroups([['state', 'in', ['requested', 'referred']]], 'Waiting for Justification')">
                            <div class="card-body">
                                <div class="justifile_kpi_value" t-esc="k.waiting"/>
                                <div class="fw-bold">Waiting for justification</div>
                                <div class="text-muted small"><t t-esc="k.high_priority_open"/> high priority · <t t-esc="k.to_review"/> to review</div>
                                <div class="justifile_cmp small" t-esc="compare('waiting')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="justifile_kpi card h-100" t-on-click="() => this.openGroups([['justified_date', '!=', false]], 'Justifications Submitted')">
                            <div class="card-body">
                                <div class="justifile_kpi_value" t-esc="show(k.avg_days_to_submit)"/>
                                <div class="fw-bold">Avg. days to submit</div>
                                <div class="text-muted small">from request to officer's justification</div>
                                <div class="justifile_cmp small" t-esc="compare('avg_days_to_submit')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="justifile_kpi card h-100" t-on-click="() => this.openContracts([['is_direct', '=', true]], 'Direct-Method Contracts')">
                            <div class="card-body">
                                <div class="justifile_kpi_value" t-esc="show(k.direct_share, '%')"/>
                                <div class="fw-bold">Direct-method share</div>
                                <div class="text-muted small"><t t-esc="k.direct_count"/> of <t t-esc="k.total_contracts"/> contracts · <t t-esc="money(k.direct_amount)"/> THB</div>
                                <div class="justifile_cmp small" t-esc="compare('direct_share', '%')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="justifile_kpi card h-100" t-on-click="() => this.openContracts([['near_threshold', '=', true], ['is_direct', '=', true]], 'Contracts Close to Threshold')">
                            <div class="card-body">
                                <div class="justifile_kpi_value" t-esc="k.near_threshold"/>
                                <div class="fw-bold">Close to threshold</div>
                                <div class="text-muted small">direct contracts just below the <t t-esc="money(state.data.params.threshold)"/> THB threshold</div>
                                <div class="justifile_cmp small" t-esc="compare('near_threshold')"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-4">
                        <div class="card h-100"><div class="card-body">
                            <h5>Status of related-contract groups</h5>
                            <div t-foreach="state.data.by_state" t-as="row" t-key="row.key" class="justifile_row"
                                 t-on-click="() => this.openGroups([['state', '=', row.key]], row.label)">
                                <div class="d-flex justify-content-between"><span t-esc="row.label"/><b t-esc="row.count"/></div>
                                <div class="justifile_bar"><div t-att-style="width(row.count, state.data.by_state)"/></div>
                            </div>
                        </div></div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card h-100"><div class="card-body">
                            <h5>Reasons given</h5>
                            <p t-if="!state.data.by_reason.length" class="text-muted">No justification submitted yet.</p>
                            <div t-foreach="state.data.by_reason" t-as="row" t-key="row.key" class="justifile_row"
                                 t-on-click="() => this.openGroups([['reason_category', '=', row.key]], row.label)">
                                <div class="d-flex justify-content-between"><span t-esc="row.label"/><b t-esc="row.count"/></div>
                                <div class="justifile_bar"><div t-att-style="width(row.count, state.data.by_reason)"/></div>
                            </div>
                        </div></div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card h-100"><div class="card-body">
                            <h5>Agencies with open requests</h5>
                            <p t-if="!state.data.open_by_agency.length" class="text-muted">Nothing is waiting for a justification.</p>
                            <div t-foreach="state.data.open_by_agency" t-as="row" t-key="row.agency" class="justifile_row"
                                 t-on-click="() => this.openGroups([['state', 'in', ['requested', 'referred']], ['agency_name', '=', row.agency]], row.agency)">
                                <div class="d-flex justify-content-between"><span t-esc="row.agency"/><b t-esc="row.count"/></div>
                                <div class="text-muted small"><t t-esc="money(row.amount)"/> THB combined</div>
                                <div class="justifile_bar"><div t-att-style="width(row.count, state.data.open_by_agency)"/></div>
                            </div>
                        </div></div>
                    </div>
                </div>
                <div class="card mt-3" t-if="state.data.by_year.length"><div class="card-body">
                    <h5>Year by year</h5>
                    <p class="text-muted small mb-2">All contracts per Thai budget year (Oct–Sep). Click a year to show it above.</p>
                    <table class="table table-sm mb-0 justifile_years">
                        <thead><tr>
                            <th>Budget year</th><th class="text-end">Contracts</th><th class="text-end">Value (THB)</th>
                            <th class="text-end">Direct method</th><th style="width: 35%"/>
                        </tr></thead>
                        <tbody>
                            <tr t-foreach="state.data.by_year" t-as="row" t-key="row.year"
                                t-att-class="{ 'table-active': state.data.year === row.year }" t-on-click="() => this.openYear(row)">
                                <td t-esc="row.year"/>
                                <td class="text-end" t-esc="row.count"/>
                                <td class="text-end" t-esc="money(row.amount)"/>
                                <td class="text-end" t-esc="show(row.direct_share, '%')"/>
                                <td><div class="justifile_bar"><div t-att-style="yearWidth(row)"/></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div></div>

                <div class="card mt-3"><div class="card-body">
                    <h5>Contracts by amount<t t-if="state.data.year"> · <t t-esc="state.data.year"/></t></h5>
                    <p class="text-muted small mb-2">
                        Number of contracts in each <t t-esc="money(state.data.params.threshold / 10)"/> THB band, up to twice the
                        bidding threshold. A peak just below the threshold followed by a drop is worth understanding.
                    </p>
                    <div class="justifile_hist">
                        <div t-foreach="state.data.amount_bands" t-as="band" t-key="band.index"
                             class="justifile_hist_col" t-att-class="{ 'justifile_hist_edge': band.just_below }"
                             t-att-title="bandTitle(band)" t-on-click="() => this.openBand(band)">
                            <div class="justifile_hist_count" t-esc="band.count or ''"/>
                            <div class="justifile_hist_plot"><div class="justifile_hist_bar" t-att-style="bandHeight(band.count)"/></div>
                            <div class="justifile_hist_label" t-esc="bandLabel(band)"/>
                        </div>
                    </div>
                    <div class="text-muted small mt-1">
                        Upper limit of each band (THB). Dashed line = bidding threshold of
                        <t t-esc="money(state.data.params.threshold)"/> THB.
                    </div>
                </div></div>
                <p class="text-muted small mt-3">
                    A group asks for a justification when direct-method contracts of one agency with the same contractor,
                    within <t t-esc="state.data.params.window_days"/> days, add up to more than
                    <t t-esc="money(state.data.params.threshold)"/> THB. It points at records to document, not at wrongdoing.
                </p>
            </div>
        </div>
    </t>
</templates>
