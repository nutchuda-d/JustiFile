<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_soi_mai" model="ir.module.category">
        <field name="name">Soi Mai</field>
        <field name="sequence">30</field>
    </record>
    <record id="res_groups_privilege_soi_mai" model="res.groups.privilege">
        <field name="name">Soi Mai</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_soi_mai"/>
    </record>

    <record id="group_soi_mai_executive" model="res.groups">
        <field name="name">Executive (view only)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_soi_mai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_soi_mai_officer" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_soi_mai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_soi_mai_auditor" model="res.groups">
        <field name="name">Internal Auditor</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_soi_mai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
